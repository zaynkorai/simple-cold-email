# ==============================================================================
# Simple Cold Email - Environment Variables Configuration
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Resend Email API Configuration
# ------------------------------------------------------------------------------
# Get your API key from https://resend.com/api-keys
# Note: If this key is omitted or contains "placeholder", the application will
# automatically operate in Simulation Mode (safe for local development/testing).
RESEND_API_KEY=re_test_placeholder

# Default sender identity.
# In Resend sandbox mode, use "onboarding@resend.dev".
# In production, use your verified domain address (e.g. "team@yourdomain.com").
FROM_EMAIL=onboarding@resend.dev

# ------------------------------------------------------------------------------
# 2. Authentication & Admin Access
# ------------------------------------------------------------------------------
# Credentials used to sign in to the web console (/login).
# If omitted, default fallback credentials are demo@client.com / password123.
ADMIN_EMAIL=demo@client.com
ADMIN_PASSWORD=password123
